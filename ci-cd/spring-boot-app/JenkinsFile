
pipeline {
    agent {
        docker {
            image 'abhishekf5/maven-abhishek-docker-agent:v1'
            args '--user root -v /var/run/docker.sock:/var/run/docker.sock'
        }
    }

    options {
        timestamps()
        skipDefaultCheckout(true)
    }

    environment {
        DOCKER_IMAGE = "khusanmakhmudov/spring-boot-app:${BUILD_NUMBER}"

        GIT_REPO_NAME = "DevOps"
        GIT_USER_NAME = "khusanmakhmudov"
        GIT_BRANCH = "main"

        APP_DIR = "java-maven/spring-boot-app"

        MANIFEST_FILE = "java-maven/spring-boot-app-manifests/deployment.yml"
    }

    stages {

        stage('Checkout') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/khusanmakhmudov/DevOps.git'

                sh 'echo "GitHub checkout successful"'
                sh 'ls -la'
            }
        }

        stage('Build and Test') {
            steps {
                dir('java-maven/spring-boot-app') {
                    sh 'mvn clean package'
                }
            }
        }

       stage('Static Code Analysis') {
    steps {
        withCredentials([
            string(credentialsId: 'sonarqube', variable: 'SONAR_TOKEN'),
            string(credentialsId: 'sonarqube-url', variable: 'SONAR_HOST_URL')
        ]) {
            dir('java-maven/spring-boot-app') {
                sh '''
                    mvn org.sonarsource.scanner.maven:sonar-maven-plugin:5.5.0.6356:sonar \
                        -Dsonar.host.url="$SONAR_HOST_URL" \
                        -Dsonar.token="$SONAR_TOKEN"
                '''
            }
        }
    }
}
        stage('Build and Push Docker Image') {
            steps {
                script {
                    dir('java-maven/spring-boot-app') {

                        sh 'docker build -t "$DOCKER_IMAGE" .'

                        def dockerImage = docker.image(DOCKER_IMAGE)

                        docker.withRegistry(
                            'https://index.docker.io/v1/',
                            'dockerhub-credentials'
                        ) {
                            dockerImage.push()
                        }
                    }
                }
            }
        }

        stage('Update Deployment File') {
            steps {
                script {

                    sh '''
                        echo "Updating Kubernetes deployment manifest..."

                        test -f "$MANIFEST_FILE" || {
                            echo "ERROR: Deployment manifest not found: $MANIFEST_FILE"
                            exit 1
                        }

                        sed -i "s/replaceImageTag/${BUILD_NUMBER}/g" "$MANIFEST_FILE"

                        echo "Updated deployment manifest:"
                        grep "image:" "$MANIFEST_FILE"
                    '''

                    sh '''
                        git config user.name "khusanmakhmudov"
                        git config user.email "khusanmakhmudov@users.noreply.github.com"

                        git add "$MANIFEST_FILE"

                        git diff --cached --quiet && {
                            echo "ERROR: No deployment manifest changes detected."
                            exit 1
                        }

                        git commit -m "[skip ci] Update deployment image to version ${BUILD_NUMBER}"
                    '''

                    withCredentials([
                        gitUsernamePassword(
                            credentialsId: 'github',
                            gitToolName: 'Default'
                        )
                    ]) {
                        sh 'git push origin HEAD:main'
                    }
                }
            }
        }
    }

    post {
        success {
            echo 'CI/CD Pipeline completed successfully!'
            echo "Docker image: ${DOCKER_IMAGE}"
        }

        failure {
            echo 'Pipeline failed. Check the Jenkins console output.'
        }
    }
}
